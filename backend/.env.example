# Server Configuration
SERVER_PORT=8080
SERVER_MODE=debug
# Local development only. Keep false on public servers.
ALLOW_MOCK_AUTH=false

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=wiseinvest
DB_PASSWORD=wiseinvest
DB_NAME=wiseinvest
DB_SSLMODE=disable

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# OpenAI / LLM Configuration
# DeepSeek: https://platform.deepseek.com/api_keys
# OpenAI:   https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_or_deepseek_api_key_here
OPENAI_MODEL=gpt-4-turbo-preview
OPENAI_MODEL_PRO=
OPENAI_BASE_URL=https://api.openai.com/v1

# SEC filing insight only. Set OPENAI_MODEL_PRO=deepseek-v4-pro for max reasoning.
# With that model, unset FILING_INSIGHT_* values default to 32768/65536/10m.
# Explicit FILING_INSIGHT_* values still take precedence.
# FILING_INSIGHT_MAX_TOKENS=8192
# FILING_INSIGHT_RETRY_MAX_TOKENS=16384
# FILING_INSIGHT_TIMEOUT=180s
# FILING_INSIGHT_THINKING=auto

# Web Search Configuration
# Official DeepSeek endpoint + OPENAI_API_KEY enables DeepSeek Search automatically.
# Optional fallback: serper (https://serper.dev) or brave (https://brave.com/search/api).
# For other model providers, this fallback is the primary search provider.
SEARCH_PROVIDER=
SEARCH_API_KEY=

# Binance Configuration
# https://www.binance.com/en/my/settings/api-management
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_API_SECRET=your_binance_api_secret_here
BINANCE_BASE_URL=https://api.binance.com
BINANCE_TESTNET=true

# Public stock-token / Hong Kong Quanto market data (no API key required)
BITGET_BASE_URL=https://api.bitget.com

# Private account access. Create a read-only key and bind the backend's outbound
# public IP. Keep these values only on the backend; never in frontend env files.
BITGET_API_KEY=
BITGET_API_SECRET=
BITGET_PASSPHRASE=
# WiseInvest user.id from GET /api/v1/auth/me; 0 disables private account access.
BITGET_OWNER_USER_ID=0
BITGET_ACCOUNT_NAME=Bitget
# uta (Unified Trading Account) or classic
BITGET_ACCOUNT_TYPE=uta
# Include stock perpetuals, including Hong Kong Quanto (read access only).
BITGET_INCLUDE_FUTURES=true

# SEC is the primary source for US reported EPS and financial statement data.
# Set the project name and a real contact email before querying EDGAR.
SEC_FUNDAMENTALS_ENABLED=true
SEC_USER_AGENT=
# Yahoo Finance supplements SEC with valuation, estimates and uncovered markets;
# access and coverage depend on the backend network. Set false to disable it.
YAHOO_FUNDAMENTALS_ENABLED=true
# Optional US earnings calendar fallback (same source as Stocksera).
FINNHUB_API_KEY=
# Optional verified company EPS guidance / fundamentals JSON, see docs.
STOCK_FUNDAMENTALS_FILE=

# JWT Configuration
JWT_SECRET=change-me-in-production
JWT_EXPIRATION=24h

# Optional: set these together ONCE to add password login to an existing user.
# Uses the existing user ID, preserving watchlists, alerts and account bindings.
# Restarts never reset an existing password. Remove these after successful setup.
# AUTH_BOOTSTRAP_USER_ID=
# AUTH_BOOTSTRAP_USERNAME=admin
# AUTH_BOOTSTRAP_PASSWORD=

# WeChat iOS OAuth (WeChat Open Platform mobile application)
WECHAT_APP_ID=your_wechat_app_id_here
WECHAT_APP_SECRET=your_wechat_app_secret_here

# WeChat mini-program credentials (separate AppID/secret from iOS)
WECHAT_MINI_APP_ID=wx870b346aceb262a5
WECHAT_MINI_APP_SECRET=your_mini_program_app_secret_here

# Tencent Cloud SMS. Leave blank until qualification, sign and template are approved.
# The approved template must contain one variable for the six-digit code.
# With no provider, /phone/send-code returns 503 rather than pretending to send.
TENCENTCLOUD_SECRET_ID=
TENCENTCLOUD_SECRET_KEY=
TENCENT_SMS_SDK_APP_ID=
TENCENT_SMS_SIGN_NAME=
TENCENT_SMS_TEMPLATE_ID=

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ── Push Notifications ────────────────────────────────────────────────────────

# 企业微信机器人 Webhook
# 在企业微信群 → 群机器人 → 添加 → 复制 Webhook 地址
WXWORK_WEBHOOK_URL=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=your_key_here

# APNs (iOS 推送) — token-based (.p8) 认证
# 从 Apple Developer 后台获取：Certificates, Identifiers & Profiles → Keys
APNS_KEY_ID=your_apns_key_id_here
APNS_TEAM_ID=your_apple_team_id_here
APNS_BUNDLE_ID=com.yourcompany.wiseinvest
APNS_KEY_FILE=apns_key.p8
APNS_PRODUCTION=false

# Additional read-only connected accounts. Owner ID is a LOCAL WiseInvest user ID.
# Binance uses the existing BINANCE_API_KEY / BINANCE_API_SECRET above (HMAC keys).
# Connected accounts use official MAINNET hosts, independent of BINANCE_BASE_URL/TESTNET.
BINANCE_OWNER_USER_ID=0
BINANCE_ACCOUNT_NAME=币安
BINANCE_ACCOUNT_TYPE=spot
BINANCE_INCLUDE_FUTURES=true
BINANCE_INCLUDE_STOCKS=true
# Gate APIv4 HMAC key, spot or unified balance mode; optional stock / USDT futures reads.
GATE_API_KEY=
GATE_API_SECRET=
GATE_OWNER_USER_ID=0
GATE_ACCOUNT_NAME=Gate
GATE_ACCOUNT_TYPE=spot
GATE_INCLUDE_FUTURES=true
GATE_INCLUDE_STOCKS=true

# Verification and target-price emails. Use your mail provider's SMTP authorization/app password.
# Without these values, email registration and email code login return 503.
# starttls: usually 587; tls: usually 465. Certificate validation stays enabled.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS_MODE=starttls
