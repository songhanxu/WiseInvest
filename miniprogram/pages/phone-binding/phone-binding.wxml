<view class="phone-page safe-area-bottom"><view class="phone-content">
  <view class="eyebrow">完善账户</view><view class="title">绑定手机号</view><view class="subtitle">用于账号安全验证，也可以稍后完成。</view>
  <view class="form-card">
    <view class="field-title">手机号</view><view class="phone-row"><view class="code">+86</view><input class="phone-input" aria-label="手机号" type="number" maxlength="11" placeholder="请输入手机号" placeholder-class="input-placeholder" value="{{phone}}" bindinput="onPhoneInput" /></view>
    <view wx:if="{{codeSent}}" class="code-wrap"><view class="field-title">验证码</view><view class="code-row"><input class="code-input" aria-label="验证码" type="number" maxlength="6" placeholder="6 位验证码" placeholder-class="input-placeholder" value="{{code}}" bindinput="onCodeInput" /><button class="resend" disabled="{{countdown > 0 || isLoading}}" bindtap="sendCode" hover-class="is-pressed">{{countdown > 0 ? countdown + ' 秒后重发' : '重新发送'}}</button></view></view>
    <button class="primary" loading="{{isLoading}}" disabled="{{disabledSubmit}}" bindtap="handlePrimaryTap" hover-class="is-pressed">{{codeSent ? '确认绑定' : '发送验证码'}}</button>
    <button class="skip" bindtap="skip" hover-class="is-pressed">稍后再说</button>
  </view>
</view></view>
