.phone-page { min-height: 100vh; background: var(--ui-bg); }
.phone-content { width: 100%; max-width: 960rpx; margin: 0 auto; padding: 28rpx 36rpx 32rpx; }
.eyebrow { color: var(--ui-muted); font-size: 22rpx; margin-bottom: 20rpx; }
.title { color: var(--ui-text); font-size: 48rpx; font-weight: 550; letter-spacing: -1rpx; }
.subtitle { color: var(--ui-muted); font-size: 25rpx; margin-top: 16rpx; line-height: 1.8; }
.form-card { margin-top: 32rpx; padding: 32rpx; border: 0; border-radius: 24rpx; background: var(--ui-panel); }
.field-title { color: var(--ui-muted); font-size: 23rpx; margin-bottom: 16rpx; }
.phone-row, .code-row { display: flex; align-items: center; gap: 12rpx; margin-bottom: 30rpx; }
.phone-row { background: var(--ui-bg); border-radius: 12rpx; }
.code { flex-shrink: 0; padding-left: 22rpx; color: var(--ui-muted); font-size: 27rpx; }
.phone-input, .code-input { flex: 1; min-width: 0; height: 92rpx; min-height: 44px; border: 0; color: var(--ui-text); font-size: 28rpx; padding: 0 20rpx; }
.code-input { background: var(--ui-bg); border-radius: 12rpx; }
.input-placeholder { color: var(--ui-muted); font-size: 25rpx; }
.resend { flex-shrink: 0; width: 200rpx; min-height: 44px; padding: 24rpx 8rpx; border-radius: 12rpx; font-size: 24rpx; color: var(--ui-accent); background: var(--ui-bg); line-height: 1.8; }
.resend[disabled] { color: var(--ui-muted); background: var(--ui-bg); }
.primary { width: 100%; min-height: 48px; margin-top: 8rpx; padding: 24rpx 12rpx; border-radius: 14rpx; color: var(--ui-on-accent); font-size: 28rpx; line-height: 1.7; font-weight: 500; background: var(--ui-accent); }
.skip { width: 100%; min-height: 44px; margin-top: 16rpx; padding: 24rpx 0; text-align: center; color: var(--ui-muted); font-size: 25rpx; }
@media (max-width: 340px) { .phone-content { padding-left: 28rpx; padding-right: 28rpx; }.form-card { padding: 26rpx; }.resend { width: 178rpx; font-size: 22rpx; } }
