<view class="market-page safe-area-bottom"><view class="intro"><view class="eyebrow">市场概览</view><view class="title">{{market.displayName}}</view><view class="subtitle">{{market.description}}</view></view><view wx:if="{{error}}" class="error">{{error}}</view><view class="actions"><button bindtap="openAgent">与 {{market.displayName}} Agent 对话 ›</button><button bindtap="openInvest">全部自选 ›</button></view><view class="section-title">市场行情</view><view wx:if="{{loading}}" class="muted">行情更新中…</view><view wx:if="{{!indices.length && !loading}}" class="empty card">暂时没有可用的市场数据</view><view wx:for="{{indices}}" wx:key="id" class="index card"><view><view class="name">{{item.name}}</view><view class="muted">{{item.source}} · {{item.quote_time}}</view></view><view class="right"><view class="value">{{item.value}}</view><view class="change {{item.change_percent >= 0 ? 'positive' : 'negative'}}">{{item.change_percent}}%</view></view></view><view class="section-title space">搜索标的</view><input class="search card" value="{{query}}" bindinput="onSearchInput" placeholder="输入公司名称或代码" /><view wx:for="{{results}}" wx:key="id" class="stock card" data-index="{{index}}" data-collection="results" bindtap="openStock"><view><view class="name">{{item.name}}</view><view class="muted">{{item.symbol}}</view></view><text>›</text></view><view class="section-title space">本市场自选</view><view wx:if="{{!stocks.length}}" class="empty card">暂无自选，前往「全部自选」添加。</view><view wx:for="{{stocks}}" wx:key="id" class="stock card" data-index="{{index}}" data-collection="stocks" bindtap="openStock"><view><view class="name">{{item.name}}</view><view class="muted">{{item.symbol}} · {{item.source}}</view></view><view class="right"><view class="value">{{item.current_price}}</view><view class="change {{item.change_percent >= 0 ? 'positive' : 'negative'}}">{{item.change_percent}}%</view></view></view></view>
