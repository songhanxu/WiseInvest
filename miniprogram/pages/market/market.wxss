.market-page { max-width:1040rpx; margin:auto; padding:32rpx 30rpx; }.intro { padding:12rpx 0 26rpx; }.eyebrow,.muted { color:#7c887b; font-size:21rpx; }.title { font-size:44rpx; font-weight:600; margin:6rpx 0; }.subtitle { color:#617262; font-size:24rpx; }.actions { display:flex; gap:12rpx; margin-bottom:30rpx; }.actions button { flex:1; background:#e8f0e5; border-radius:10rpx; padding:18rpx 12rpx; color:#345b3c; font-size:22rpx; }.section-title { font-size:28rpx; font-weight:600; margin-bottom:16rpx; }.space { margin-top:30rpx; }.card { padding:22rpx; border-radius:14rpx; margin-bottom:12rpx; }.index,.stock { display:flex; justify-content:space-between; align-items:center; gap:10rpx; }.name { font-size:26rpx; font-weight:550; }.right { text-align:right; }.value { font-size:27rpx; font-weight:600; font-variant-numeric:tabular-nums; }.change { font-size:22rpx; }.positive { color:#bb5a4b; }.negative { color:#338469; }.empty { color:#7c887b; text-align:center; }.search { width:100%; background:#fff; font-size:24rpx; }.error { padding:14rpx; color:#ab5230; font-size:22rpx; }
