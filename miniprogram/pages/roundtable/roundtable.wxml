<view class="roundtable"><view class="heading"><view class="title">慧投圆桌</view><view class="subtitle">让不同视角交叉验证</view></view><scroll-view scroll-x class="agent-scroll"><view class="agents"><button class="agent {{!participants.length ? 'active' : ''}}" bindtap="selectAll">全部</button><button wx:for="{{agents}}" wx:key="id" class="agent {{item.selected ? 'active' : ''}}" data-id="{{item.id}}" bindtap="toggleAgent">{{item.name}}</button></view></scroll-view><scroll-view scroll-y class="messages" scroll-into-view="{{scrollIntoView}}"><view wx:for="{{messages}}" wx:key="id" class="message {{item.role === 'user' ? 'mine' : ''}}"><view wx:if="{{item.role === 'assistant'}}" class="speaker">{{item.name}}</view><rich-text nodes="{{item.html}}"></rich-text></view><view wx:if="{{busy}}" class="progress">{{progress}}</view><view id="bottom"></view></scroll-view><view wx:if="{{error}}" class="error">{{error}}</view><view class="composer safe-area-bottom"><textarea value="{{input}}" bindinput="onInput" auto-height maxlength="3000" placeholder="提出你的研究问题，可用 @ 指定角色" /><button bindtap="send" disabled="{{busy || !input}}">发送</button></view></view>
