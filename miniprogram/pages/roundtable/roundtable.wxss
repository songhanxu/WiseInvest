.roundtable { position: fixed; top: 0; right: 0; bottom: 0; left: 0; display: flex; flex-direction: column; overflow: hidden; background: #f2f2f7; }
.heading { flex: none; padding: 24rpx 36rpx; background: #fff; }.title { font-size: 32rpx; font-weight: 600; }.subtitle { margin-top: 6rpx; color: #8e8e93; font-size: 24rpx; }
.agent-scroll { flex: none; width: 100%; white-space: nowrap; background: #fff; border-bottom: 1rpx solid #e5e5ea; }.agents { display: flex; padding: 4rpx 28rpx 20rpx; }.agent { flex: none; min-height: 44px; margin-right: 12rpx; border-radius: 32rpx; padding: 16rpx 22rpx; color: #8e8e93; background: #f2f2f7; font-size: 24rpx; }.agent.active { background: #e5e5ea; color: #007aff; }
.messages { flex: 1; height: 0; min-height: 0; width: 100%; }.message-content { max-width: 1040rpx; margin: auto; padding: 28rpx 32rpx; }.message { width: 100%; padding: 24rpx; border-radius: 18rpx; background: #fff; margin-bottom: 24rpx; font-size: 28rpx; line-height: 1.8; overflow-wrap: anywhere; }.message.mine { width: fit-content; max-width: 92%; margin-left: auto; background: #e5e5ea; }.speaker { color: #48484a; font-size: 24rpx; font-weight: 600; margin-bottom: 12rpx; }.progress { color: #8e8e93; font-size: 24rpx; padding-bottom: 24rpx; }.error { flex: none; padding: 16rpx 28rpx; color: #a15d4e; font-size: 24rpx; line-height: 1.6; }
.composer { flex: none; display: flex; align-items: flex-end; padding: 18rpx 24rpx; padding-bottom: calc(20rpx + env(safe-area-inset-bottom)); background: #fff; border-top: 1rpx solid #e5e5ea; }.keyboard-open .composer { padding-bottom: 16rpx; }.composer textarea { flex: 1; min-width: 0; min-height: 44px; max-height: 220rpx; background: #f2f2f7; border-radius: 16rpx; padding: 20rpx; font-size: 28rpx; line-height: 1.6; }.composer button { flex: none; width: 108rpx; min-height: 44px; margin-left: 14rpx; padding: 22rpx 8rpx; border-radius: 14rpx; background: #007aff; color: #fff; font-size: 26rpx; }.composer button[disabled] { opacity: 1; background: #f2f2f7; color: #8e8e93; }
@media (max-width: 340px) { .message-content { padding-left: 24rpx; padding-right: 24rpx; }.heading { padding-left: 28rpx; padding-right: 28rpx; } }

.roundtable { background: #fff; }.subtitle { display: none; }.agent-scroll { border-bottom-color: #f2f2f7; }.agent { background: transparent; color: #8e8e93; }.agent.active { background: #f2f2f7; color: #1c1c1e; }.message { padding-left: 0; padding-right: 0; border-radius: 0; background: transparent; }.message.mine { padding: 24rpx; border-radius: 24rpx; background: #f2f2f7; }.speaker { color: #636366; }
