page { height:100%; }.roundtable { height:100vh; display:flex; flex-direction:column; background:#f7f8f6; }.heading { padding:22rpx 30rpx 14rpx; }.title { font-size:32rpx; font-weight:600; }.subtitle { color:#798778; font-size:22rpx; }.agent-scroll { flex:none; white-space:nowrap; border-bottom:1rpx solid #e5e9e0; }.agents { display:flex; gap:10rpx; padding:10rpx 26rpx 18rpx; }.agent { flex:none; border-radius:28rpx; padding:10rpx 20rpx; color:#788478; background:#fff; font-size:22rpx; }.agent.active { background:#dfeade; color:#345b39; }.messages { flex:1; min-height:0; padding:20rpx 28rpx; box-sizing:border-box; }.message { width:fit-content; max-width:92%; padding:20rpx 24rpx; border-radius:14rpx; background:#fff; margin-bottom:18rpx; font-size:25rpx; line-height:1.7; }.message.mine { margin-left:auto; background:#e5eee3; }.speaker { color:#55715a; font-size:21rpx; font-weight:600; margin-bottom:8rpx; }.progress { color:#748575; font-size:22rpx; padding-bottom:25rpx; }.error { color:#a95335; padding:10rpx 28rpx; font-size:22rpx; }.composer { display:flex; gap:12rpx; align-items:flex-end; padding:16rpx 26rpx; background:#fff; border-top:1rpx solid #e6ebe3; }.composer textarea { flex:1; min-height:62rpx; max-height:220rpx; background:#f5f7f4; border-radius:12rpx; padding:12rpx; font-size:25rpx; }.composer button { background:#36573d; color:#fff; border-radius:10rpx; padding:14rpx 22rpx; font-size:24rpx; }
