<view class="home-page safe-area-bottom">
  <view class="content">
    <view class="header">
      <view class="brand"><view class="brand-mark"><view class="bar bar-one"></view><view class="bar bar-two"></view><view class="bar bar-three"></view></view><view><view class="brand-name">慧投</view><view class="brand-caption">投资研究工作台</view></view></view>
      <button class="account-button" bindtap="openAccountMenu" hover-class="is-pressed" aria-label="账户选项">{{guest ? '登录' : '账户'}}<text class="account-arrow">⌄</text></button>
    </view>
    <view class="intro">
      <view class="eyebrow">{{todayLabel}}</view>
      <view class="intro-title">看清市场，从容决策。</view>
      <view class="intro-copy">从一个市场、一家公司，开始你的研究。</view>
    </view>
    <view class="quick-actions">
      <view class="quick-action quick-action-primary" bindtap="openInvest" hover-class="is-pressed" role="button" aria-label="进入我的投资">
        <view class="quick-action-copy"><view class="quick-action-title">我的投资</view><view class="quick-action-note">自选、财报解读、持仓与价格提醒</view></view>
        <view class="quick-action-arrow">›</view>
      </view>
      <view class="quick-action" bindtap="openRoundtable" hover-class="is-pressed" role="button" aria-label="进入慧投圆桌">
        <view class="quick-action-copy"><view class="quick-action-title">慧投圆桌</view><view class="quick-action-note">价值、趋势、量化多角度讨论</view></view>
        <view class="quick-action-arrow">›</view>
      </view>
    </view>
    <view class="section-heading"><view class="section-title">市场研究</view><view class="section-note">选择市场开始</view></view>
    <view class="markets">
      <view wx:for="{{markets}}" wx:key="id" class="market-slot {{index === markets.length - 1 && markets.length % 2 ? 'market-slot-wide' : ''}}">
        <market-card market="{{item}}" wide="{{index === markets.length - 1 && markets.length % 2}}" bindtapcard="onTapMarket"></market-card>
      </view>
    </view>
    <view class="section-heading recent-heading"><view class="section-title">继续研究</view><view wx:if="{{recentConversations.length}}" class="section-note">最近 {{recentConversations.length}} 条</view></view>
    <view wx:if="{{recentConversations.length}}" class="recent-list">
      <recent-row wx:for="{{recentConversations}}" wx:key="id" conversation="{{item}}" bindtaprow="onTapRecentConversation" binddelete="onDeleteRecentConversation"></recent-row>
    </view>
    <view wx:else class="recent-empty"><view class="empty-mark">↗</view><view class="empty-title">第一份研究，从这里开始</view><view class="empty-desc">选择上方市场，与慧投聊聊你关注的标的。</view></view>
    <view class="page-note">专注研究，审慎决策。</view>
  </view>
</view>
