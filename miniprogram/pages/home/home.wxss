.home-page { min-height: 100vh; background: #f7f8f6; }
.content { max-width: 1040rpx; margin: 0 auto; padding: 28rpx 36rpx 20rpx; }
.header, .brand { display: flex; align-items: center; }
.header { justify-content: space-between; }
.brand { gap: 16rpx; }
.brand-mark { width: 62rpx; height: 62rpx; border-radius: 14rpx; background: #344e38; display: flex; align-items: flex-end; justify-content: center; gap: 6rpx; padding-bottom: 17rpx; }
.bar { width: 5rpx; background: #edf4e9; border-radius: 2rpx; }
.bar-one { height: 18rpx; }.bar-two { height: 30rpx; }.bar-three { height: 24rpx; }
.brand-name { font-size: 34rpx; font-weight: 600; letter-spacing: 2rpx; }
.brand-caption { margin-top: 3rpx; font-size: 20rpx; color: #74806c; }
.account-button { display: flex; align-items: center; justify-content: center; min-width: 104rpx; min-height: 44px; font-size: 24rpx; color: #53644d; }
.account-arrow { margin-left: 10rpx; color: #89957f; }
.intro { padding: 52rpx 0 38rpx; }
.eyebrow { color: #7b8773; font-size: 21rpx; letter-spacing: 1rpx; margin-bottom: 16rpx; }
.intro-title { font-size: 42rpx; font-weight: 550; letter-spacing: -1rpx; line-height: 1.45; }
.intro-copy { margin-top: 14rpx; color: #74806c; font-size: 24rpx; line-height: 1.8; }
.overview { display: flex; padding-bottom: 34rpx; margin-bottom: 38rpx; }
.overview-item { flex: 1; min-width: 0; padding-left: 26rpx; border-left: 1rpx solid #e1e7dc; }
.overview-item:first-child { padding-left: 0; border-left: 0; }
.overview-label { color: #76816e; font-size: 22rpx; margin-bottom: 12rpx; }
.overview-value { font-size: 42rpx; font-weight: 500; font-variant-numeric: tabular-nums; line-height: 1.2; }
.overview-value text { margin-left: 8rpx; font-size: 20rpx; color: #87917f; font-weight: 400; }
.overview-status { font-size: 25rpx; color: #45633d; padding-top: 8rpx; }
.section-heading { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; margin-bottom: 22rpx; }
.section-title { font-size: 30rpx; font-weight: 600; }
.section-note { color: #7c8774; font-size: 21rpx; }
.markets { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20rpx; }
.market-slot { min-width: 0; }.market-slot-wide { grid-column: 1 / -1; }
.recent-heading { margin-top: 42rpx; }
.recent-list { background: #fff; border-radius: 20rpx; padding: 10rpx; }
.recent-empty { text-align: center; padding: 36rpx 24rpx; border-radius: 20rpx; background: #fff; }
.empty-mark { color: #7d9274; font-size: 40rpx; margin-bottom: 12rpx; }
.empty-title { color: #47543f; font-size: 26rpx; font-weight: 500; }
.empty-desc { color: #7c8774; font-size: 23rpx; line-height: 1.8; margin-top: 8rpx; }
.page-note { padding-top: 30rpx; color: #88937f; font-size: 20rpx; text-align: center; }
.invest-entry { display:flex; align-items:center; justify-content:space-between; width:100%; padding:28rpx; margin-bottom:38rpx; background:#e8f0e5; border-radius:16rpx; text-align:left; color:#2f5237; }
.invest-entry-title { font-size:30rpx; font-weight:600; }.invest-entry-note { margin-top:6rpx; font-size:22rpx; color:#61735f; }.invest-entry > text { font-size:44rpx; }
.roundtable-entry { background:#fff; border:1rpx solid #e5e9e0; margin-top:-20rpx; }
@media (max-width: 340px) { .content { padding-left: 28rpx; padding-right: 28rpx; }.intro-title { font-size: 39rpx; }.overview-item { padding-left: 18rpx; } }
