.invest { max-width:1040rpx; margin:auto; padding:32rpx 30rpx; }.intro { padding:14rpx 0 28rpx; }.eyebrow { color:#647b64; font-size:22rpx; }.title { font-size:46rpx; font-weight:600; margin-top:8rpx; }.subtitle,.muted { color:#798477; font-size:22rpx; }.subtitle { margin-top:8rpx; }.tabs { display:flex; gap:28rpx; border-bottom:1rpx solid #e0e7dc; margin-bottom:26rpx; }.tabs button { padding:16rpx 8rpx; color:#788474; font-size:28rpx; }.tabs .active { color:#315637; border-bottom:4rpx solid #315637; font-weight:600; }.card { padding:24rpx; margin-bottom:16rpx; border-radius:16rpx; }.search input,.settings input { background:#f5f7f4; border-radius:10rpx; padding:16rpx; margin:12rpx 0; }.label { font-size:25rpx; font-weight:600; }.picker { font-size:22rpx; color:#5e735e; padding:8rpx 0; }.search-row,.stock-head,.stock-bottom { display:flex; align-items:center; justify-content:space-between; gap:12rpx; }.search-row { border-top:1rpx solid #edf0eb; padding:14rpx 0; }.search-row button,.settings button { color:#315637; font-size:23rpx; }.filters { white-space:nowrap; margin:8rpx 0 20rpx; }.filter-inner { display:flex; gap:10rpx; }.filter { flex:none; padding:12rpx 22rpx; border-radius:32rpx; background:#fff; color:#778375; font-size:22rpx; }.selected { color:#315637; background:#e6eee4; }.row-title { font-size:28rpx; font-weight:600; }.code { color:#849082; font-size:20rpx; font-weight:400; }.stock-head { margin-bottom:16rpx; }.stock-bottom { padding-top:8rpx; }.price { font-size:32rpx; font-weight:600; font-variant-numeric:tabular-nums; }.price text { font-size:20rpx; font-weight:400; color:#809080; }.change { font-size:23rpx; }.positive { color:#bd594b; }.negative { color:#328269; }.arrow { color:#81917e; font-size:30rpx; }.remove { color:#8f9b8d; font-size:20rpx; }.account .muted,.equity .price { margin-top:8rpx; }.empty { text-align:center; color:#849080; padding:52rpx 20rpx; }.error { background:#fff4ed; color:#ad5a35; padding:14rpx; border-radius:10rpx; margin:12rpx 0; font-size:22rpx; }
.holding-alert { display:flex; gap:10rpx; align-items:center; margin-top:16rpx; padding-top:12rpx; border-top:1rpx solid #eef1ec; }.holding-alert input { flex:1; min-width:0; background:#f5f7f4; border-radius:8rpx; padding:12rpx; font-size:22rpx; }.holding-alert button { color:#315637; font-size:21rpx; }
