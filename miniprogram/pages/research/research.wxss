.research { width: 100%; max-width: 1040rpx; margin: auto; padding: 28rpx 36rpx; padding-bottom: calc(32rpx + env(safe-area-inset-bottom)); }
.research .title { font-size: 44rpx; }
.grid { display: flex; flex-wrap: wrap; margin-bottom: -24rpx; }
.grid > view { width: 50%; min-width: 0; padding-right: 16rpx; margin-bottom: 24rpx; }
.value { font-size: 34rpx; font-weight: 600; margin-top: 8rpx; line-height: 1.4; overflow-wrap: anywhere; }
.small { font-size: 26rpx; }.note { margin-top: 24rpx; padding-top: 20rpx; border-top: 1rpx solid var(--ui-bg); font-size: 22rpx; }
.insight { display: block; font-size: 28rpx; line-height: 1.8; margin-top: 24rpx; white-space: normal; overflow-wrap: anywhere; }
.report { padding: 24rpx 0 6rpx; border-top: 1rpx solid var(--ui-bg); }.report-head { margin-bottom: 16rpx; }.report-head .muted { margin-top: 6rpx; }
.metric { display: flex; justify-content: space-between; font-size: 24rpx; padding: 10rpx 0; color: var(--ui-muted); }.metric text { width: 47%; min-width: 0; overflow-wrap: anywhere; }.metric text:last-child { color: var(--ui-text); text-align: right; }
.alert-row { display: flex; flex-wrap: wrap; margin-top: 20rpx; }.alert-row input { flex: 1 1 100%; width: 100%; height: 84rpx; padding: 0 22rpx; margin-bottom: 10rpx; border-radius: 12rpx; background: var(--ui-bg); font-size: 26rpx; }.alert-row button { min-height: 44px; padding: 16rpx 24rpx; color: var(--ui-accent); font-size: 26rpx; }
.quote-line { display: flex; flex-wrap: wrap; align-items: baseline; margin-bottom: 12rpx; }.quote-value { min-width: 0; font-size: 46rpx; font-weight: 600; overflow-wrap: anywhere; }.quote-value text { font-size: 24rpx; color: var(--ui-muted); font-weight: 400; }.quote-change { margin-left: 20rpx; font-size: 26rpx; }
.periods { display: flex; padding: 4rpx; margin-bottom: 20rpx; border-radius: 12rpx; background: var(--ui-bg); }.periods button { flex: 1; min-width: 0; min-height: 44px; padding: 14rpx 8rpx; border-radius: 10rpx; font-size: 24rpx; color: var(--ui-muted); }.periods .active { color: var(--ui-accent); background: var(--ui-fill); }
.kline { display: block; width: 100%; height: 320rpx; }
.news { padding: 24rpx 0 8rpx; border-top: 1rpx solid var(--ui-bg); }.news-title { margin-bottom: 8rpx; font-size: 28rpx; line-height: 1.5; font-weight: 600; overflow-wrap: anywhere; }.news-summary { color: var(--ui-muted); font-size: 25rpx; margin-top: 12rpx; line-height: 1.7; }
.research-actions { display: flex; justify-content: space-between; }.research-actions button { width: 48.5%; min-height: 48px; padding: 20rpx 12rpx; background: var(--ui-fill); color: var(--ui-accent); border-radius: 14rpx; font-size: 25rpx; }
@media (max-width: 340px) { .research { padding-left: 28rpx; padding-right: 28rpx; }.research .card { padding: 24rpx; }.research .title { font-size: 40rpx; }.small { font-size: 24rpx; } }

.research .heading { padding-bottom: 28rpx; }.research .title { margin-top: 12rpx; letter-spacing: -1rpx; }.research .section-title { font-size: 29rpx; font-weight: 600; }
.section-toggle { display: flex; align-items: center; justify-content: space-between; width: 100%; min-height: 44px; text-align: left; color: var(--ui-text); font-size: 29rpx; font-weight: 500; }.toggle-chevron { padding-left: 20rpx; color: var(--ui-muted); font-size: 32rpx; font-weight: 400; }
.research .disclosure { padding-top: 16rpx; padding-bottom: 16rpx; }.research-actions button { color: var(--ui-accent); background: var(--ui-panel); }.periods .active { color: var(--ui-text); background: var(--ui-panel); }.quote-card .section-title { color: var(--ui-muted); font-size: 25rpx; font-weight: 400; }
