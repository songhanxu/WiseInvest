.research { max-width:1040rpx; margin:auto; padding:34rpx 30rpx; }.heading { padding:12rpx 0 28rpx; }.eyebrow,.muted { color:#7b887a; font-size:22rpx; }.title { font-size:43rpx; font-weight:600; margin:8rpx 0; }.subtitle { color:#667866; font-size:24rpx; }.card { padding:26rpx; border-radius:16rpx; margin-bottom:18rpx; }.section-title { font-size:28rpx; font-weight:600; margin-bottom:17rpx; }.grid { display:grid; grid-template-columns:1fr 1fr; gap:26rpx 12rpx; }.value { font-size:31rpx; font-weight:550; margin-top:5rpx; }.small { font-size:25rpx; }.note { margin-top:20rpx; }.insight { display:block; font-size:24rpx; line-height:1.8; margin:18rpx 0; }.source { color:#315d44; font-size:22rpx; margin-top:16rpx; text-align:left; }.report { padding:18rpx 0; border-top:1rpx solid #edf0ea; }.report-head { display:flex; justify-content:space-between; align-items:center; }.metric { display:flex; justify-content:space-between; gap:15rpx; color:#697769; font-size:22rpx; padding:6rpx 0; }.metric text:last-child { color:#2e3b2f; text-align:right; }.alert-row { display:flex; gap:12rpx; margin-top:16rpx; }.alert-row input { flex:1; min-width:0; background:#f4f7f2; border-radius:8rpx; padding:12rpx; }.alert-row button,.action { color:#315d44; font-size:23rpx; padding:12rpx; }.error { background:#fff3ea; color:#a75331; padding:15rpx; border-radius:10rpx; margin-bottom:15rpx; font-size:22rpx; }
.quote-line { display:flex; align-items:center; justify-content:space-between; }.quote-value { font-size:42rpx; font-weight:600; }.quote-value text { font-size:22rpx; color:#849084; font-weight:400; }.quote-change { font-size:26rpx; }.positive { color:#bd594b; }.negative { color:#328269; }.periods { display:flex; gap:8rpx; margin-bottom:16rpx; }.periods button { flex:1; font-size:21rpx; padding:10rpx; border-radius:8rpx; color:#728172; background:#f3f6f2; }.periods .active { color:#315637; background:#e2ecdf; }.kline { width:100%; height:300rpx; }.news { padding:17rpx 0; border-top:1rpx solid #edf0ea; }.news-title { font-size:24rpx; font-weight:550; }.news-summary { color:#6e7a6e; font-size:22rpx; margin-top:7rpx; line-height:1.6; }.research-actions { display:flex; gap:10rpx; }.research-actions button { flex:1; padding:18rpx 8rpx; background:#e6efe3; color:#335d3d; border-radius:10rpx; font-size:22rpx; }
