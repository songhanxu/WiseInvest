.research { width: 100%; max-width: 1040rpx; margin: auto; padding: 28rpx 36rpx; padding-bottom: calc(32rpx + env(safe-area-inset-bottom)); }
.research .title { font-size: 44rpx; }
.grid { display: flex; flex-wrap: wrap; margin-bottom: -24rpx; }
.grid > view { width: 50%; min-width: 0; padding-right: 16rpx; margin-bottom: 24rpx; }
.value { font-size: 34rpx; font-weight: 600; margin-top: 8rpx; line-height: 1.4; overflow-wrap: anywhere; }
.small { font-size: 26rpx; }.note { margin-top: 24rpx; padding-top: 20rpx; border-top: 1rpx solid #edf0ea; font-size: 22rpx; }
.insight { display: block; font-size: 28rpx; line-height: 1.8; margin-top: 24rpx; white-space: normal; overflow-wrap: anywhere; }
.report { padding: 24rpx 0 6rpx; border-top: 1rpx solid #edf0ea; }.report-head { margin-bottom: 16rpx; }.report-head .muted { margin-top: 6rpx; }
.metric { display: flex; justify-content: space-between; font-size: 24rpx; padding: 10rpx 0; color: #697769; }.metric text { width: 47%; min-width: 0; overflow-wrap: anywhere; }.metric text:last-child { color: #2e3b2f; text-align: right; }
.alert-row { display: flex; flex-wrap: wrap; margin-top: 20rpx; }.alert-row input { flex: 1 1 100%; width: 100%; height: 84rpx; padding: 0 22rpx; margin-bottom: 10rpx; border-radius: 12rpx; background: #f4f7f2; font-size: 26rpx; }.alert-row button { min-height: 44px; padding: 16rpx 24rpx; color: #36573d; font-size: 26rpx; }
.quote-line { display: flex; flex-wrap: wrap; align-items: baseline; margin-bottom: 12rpx; }.quote-value { min-width: 0; font-size: 46rpx; font-weight: 600; overflow-wrap: anywhere; }.quote-value text { font-size: 24rpx; color: #849084; font-weight: 400; }.quote-change { margin-left: 20rpx; font-size: 26rpx; }
.periods { display: flex; padding: 4rpx; margin-bottom: 20rpx; border-radius: 12rpx; background: #f3f6f2; }.periods button { flex: 1; min-width: 0; min-height: 44px; padding: 14rpx 8rpx; border-radius: 10rpx; font-size: 24rpx; color: #728172; }.periods .active { color: #315637; background: #e2ecdf; }
.kline { display: block; width: 100%; height: 320rpx; }
.news { padding: 24rpx 0 8rpx; border-top: 1rpx solid #edf0ea; }.news-title { margin-bottom: 8rpx; font-size: 28rpx; line-height: 1.5; font-weight: 600; overflow-wrap: anywhere; }.news-summary { color: #6e7a6e; font-size: 25rpx; margin-top: 12rpx; line-height: 1.7; }
.research-actions { display: flex; justify-content: space-between; }.research-actions button { width: 48.5%; min-height: 48px; padding: 20rpx 12rpx; background: #e6efe3; color: #335d3d; border-radius: 14rpx; font-size: 25rpx; }
@media (max-width: 340px) { .research { padding-left: 28rpx; padding-right: 28rpx; }.research .card { padding: 24rpx; }.research .title { font-size: 40rpx; }.small { font-size: 24rpx; } }
