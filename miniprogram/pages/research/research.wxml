<view class="research safe-area-bottom"><view class="heading"><view class="eyebrow">{{market}} · {{symbol}}</view><view class="title">{{name}}</view><view class="subtitle">财务数据与最新申报</view></view>
  <view wx:if="{{error}}" class="error">{{error}}</view>
  <view wx:if="{{quote}}" class="card quote-card"><view class="section-title">实时行情</view><view class="quote-line"><view class="quote-value">{{quote.current_price}} <text>{{quote.currency}}</text></view><view class="quote-change {{quote.change_percent >= 0 ? 'positive' : 'negative'}}">{{quote.change_percent}}%</view></view><view class="muted">{{quote.source}} · {{quote.quote_time || '报价时间未提供'}}</view><button wx:if="{{!watched}}" class="action" bindtap="addToWatchlist">加入自选</button></view>
  <view class="card"><view class="section-title">价格走势</view><view class="periods"><button class="{{period === '15m' ? 'active' : ''}}" data-period="15m" bindtap="setPeriod">15分</button><button class="{{period === '1h' ? 'active' : ''}}" data-period="1h" bindtap="setPeriod">1时</button><button class="{{period === '1d' ? 'active' : ''}}" data-period="1d" bindtap="setPeriod">日K</button><button class="{{period === '1w' ? 'active' : ''}}" data-period="1w" bindtap="setPeriod">周K</button></view><canvas wx:if="{{candles.length}}" canvas-id="kline" id="kline" class="kline"></canvas><view wx:else class="muted">暂无该周期的 K 线数据</view></view>
  <view wx:if="{{loading}}" class="card muted">正在读取财务数据…</view>
  <view wx:if="{{fundamentals}}" class="card"><view class="section-title">财务概览</view><view class="grid"><view><view class="muted">每股收益 EPS</view><view class="value">{{fundamentals.eps === null ? '—' : fundamentals.eps}}</view></view><view><view class="muted">市盈率 PE</view><view class="value">{{fundamentals.pe === null ? '—' : fundamentals.pe}}</view></view><view><view class="muted">预期 PE</view><view class="value">{{fundamentals.forward_pe === null ? '—' : fundamentals.forward_pe}}</view></view><view><view class="muted">下次财报</view><view class="value small">{{fundamentals.next_earnings_date || '待确认'}}</view></view></view><view wx:if="{{fundamentals.message}}" class="muted note">{{fundamentals.message}}</view></view>
  <view wx:if="{{market === 'us_stock'}}" class="card"><view class="section-title">最新财报 AI 解读</view><view wx:if="{{insightCurrent}}"><view class="muted">{{insight.report_date}} · {{insight.generated_at}}</view><rich-text nodes="{{insightHTML}}" class="insight"></rich-text><view wx:for="{{sources}}" wx:key="url" data-url="{{item.url}}" bindtap="copySource" class="source">{{item.label}} · 复制来源链接 ↗</view></view><view wx:elif="{{insight && insight.status === 'pending'}}" class="muted">正在根据 SEC 财报生成解读…</view><view wx:else class="muted">{{insight && insight.status === 'ready' ? '这份解读对应旧财报，请更新。' : insight && insight.message || '暂时没有可用的财报解读'}}</view><button wx:if="{{watched && reports.length && (!insight || (insight.status !== 'pending' && !insightCurrent))}}" bindtap="retryInsight" class="action">重新生成</button></view>
  <view class="card"><view class="section-title">财报原文与指标</view><view wx:if="{{!reports.length}}" class="muted">暂无可核验的财报</view><view wx:for="{{reports}}" wx:key="accession" class="report"><view class="report-head"><view class="value small">{{item.displayForm}} · {{item.report_date}}</view><view class="muted">提交 {{item.filed_date}}</view></view><view wx:if="{{item.kind === 'earnings_release'}}" class="muted">业绩发布稿；完整 10-Q/10-K 尚未提交。</view><view wx:for="{{item.metricRows}}" wx:for-item="metric" wx:key="label" class="metric"><text>{{metric.label}}</text><text>{{metric.value}} {{metric.unit}}</text></view><button wx:if="{{item.source_url}}" class="source" data-url="{{item.source_url}}" bindtap="copySource">复制 SEC 原文链接 ↗</button></view></view>
  <view class="card"><view class="section-title">价格提醒</view><view class="muted">达到目标价后发送邮件。先在「我的投资」中设置邮箱。</view><view class="alert-row"><input type="digit" value="{{targetPrice}}" bindinput="onTargetPrice" placeholder="目标价格" /><button bindtap="saveAlert">保存</button><button wx:if="{{alert}}" bindtap="removeAlert">删除</button></view></view>
  <view class="card"><view class="section-title">最新资讯</view><view wx:if="{{!news.length}}" class="muted">暂无资讯</view><view wx:for="{{news}}" wx:key="id" class="news"><view class="news-title">{{item.title}}</view><view class="muted">{{item.source}} · {{item.time}}</view><view wx:if="{{item.summary}}" class="news-summary">{{item.summary}}</view><button wx:if="{{item.url}}" class="source" data-url="{{item.url}}" bindtap="copySource">复制原文链接 ↗</button></view></view>
  <view class="research-actions"><button bindtap="openAgent">问 AI Agent ›</button><button bindtap="openRoundtable">交给圆桌讨论 ›</button></view>
</view>
