.login-page { min-height: 100vh; background: #f7f8f6; }
.content { width: 100%; max-width: 960rpx; margin: 0 auto; min-height: 100vh; padding: 64rpx 42rpx 40rpx; padding-bottom: calc(40rpx + env(safe-area-inset-bottom)); display: flex; flex-direction: column; }
.brand-block { display: flex; align-items: center; flex-wrap: wrap; gap: 16rpx; }
.brand-symbol { display: flex; align-items: flex-end; justify-content: center; gap: 7rpx; width: 70rpx; height: 70rpx; border-radius: 16rpx; padding-bottom: 18rpx; background: #344e38; }
.brand-bar { width: 6rpx; border-radius: 2rpx; background: #f1f7ec; }.brand-bar.short { height: 20rpx; }.brand-bar.tall { height: 34rpx; }.brand-bar.medium { height: 26rpx; }
.brand-cn { font-size: 42rpx; font-weight: 600; letter-spacing: 2rpx; }
.brand-en { color: #7e8976; font-size: 21rpx; letter-spacing: 2rpx; margin-left: auto; }
.login-intro { margin: 86rpx 0 64rpx; }
.intro-eyebrow { font-size: 23rpx; color: #76846b; margin-bottom: 22rpx; }
.intro-title { font-size: 54rpx; line-height: 1.6; letter-spacing: -1rpx; font-weight: 550; color: #263322; }
.brand-desc { max-width: 580rpx; color: #74806c; font-size: 26rpx; line-height: 1.9; margin-top: 24rpx; }
.login-card { background: #fff; border: 1rpx solid #e5e9e0; border-radius: 20rpx; padding: 32rpx; }
.card-title { font-size: 30rpx; font-weight: 550; color: #2d3928; }
.card-subtitle { margin-top: 12rpx; font-size: 24rpx; color: #75806d; line-height: 1.8; }
.wechat-btn { margin-top: 32rpx; width: 100%; min-height: 48px; padding: 22rpx; border-radius: 14rpx; background: #36543c; color: #fff; font-size: 28rpx; line-height: 1.8; font-weight: 500; }
.wechat-btn::after { border: 0; }
.feature-row { display: flex; align-items: center; justify-content: center; flex-wrap: wrap; gap: 12rpx; padding-top: 26rpx; color: #77866d; font-size: 21rpx; }
.feature-dot { color: #a4ae9a; }
.login-note { margin-top: auto; padding-top: 40rpx; color: #8a957e; text-align: center; font-size: 21rpx; }
@media (max-height: 640px) { .content { padding-top: 34rpx; }.login-intro { margin: 40rpx 0; }.intro-title { font-size: 48rpx; } }
@media (max-width: 340px) { .content { padding-left: 32rpx; padding-right: 32rpx; }.brand-en { font-size: 19rpx; }.intro-title { font-size: 48rpx; }.login-card { padding: 26rpx; } }
