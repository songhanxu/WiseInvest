<view class="conversation-page {{keyboardHeight > 0 ? 'keyboard-open' : ''}}" style="bottom: {{keyboardHeight}}px;">
  <view class="header"><view class="header-inner"><view class="market-icon">{{market.mark}}</view><view class="market-meta"><view class="market-name">{{market.displayName}}研究</view><view class="market-subtitle">{{market.focus}}</view></view><button class="menu" disabled="{{isLoading}}" bindtap="openMenu" aria-label="对话选项" hover-class="is-pressed">···</button></view></view>
  <scroll-view id="msg-scroll" scroll-y class="message-scroll" scroll-with-animation scroll-into-view="{{scrollIntoView}}" enhanced show-scrollbar="false"><view class="messages"><view class="conversation-note">AI 辅助研究 · 重要信息请交叉核验</view><message-bubble wx:for="{{messages}}" wx:key="id" id="msg-{{item.id}}" message="{{item}}" show-regenerate="{{item.id === lastRegeneratableAssistantId}}" bindregenerate="onRegenerate"></message-bubble><view id="msg-bottom" class="bottom-anchor"></view></view></scroll-view>
  <view wx:if="{{errorMessage}}" class="error-banner" role="alert">{{errorMessage}}</view>
  <view class="chat-selection"><picker range="{{modelOptions}}" range-key="label" value="{{modelIndex}}" disabled="{{isLoading}}" bindchange="onModelChange"><view class="selection-pill">{{modelOptions[modelIndex].label}} ⌄</view></picker><picker range="{{effortOptions}}" range-key="label" value="{{effortIndex}}" disabled="{{isLoading}}" bindchange="onEffortChange"><view class="selection-pill">思考 · {{effortOptions[effortIndex].label}} ⌄</view></picker></view>
  <view class="input-wrap"><view class="input-box"><textarea class="input" value="{{inputText}}" aria-label="研究问题" placeholder="聊聊你关注的标的…" placeholder-class="input-placeholder" maxlength="-1" auto-height show-confirm-bar="false" adjust-position="false" cursor-spacing="16" disabled="{{isLoading}}" bindinput="onInput" bindkeyboardheightchange="onKeyboardHeightChange" bindblur="onInputBlur" /></view><button class="send" disabled="{{!inputText || isLoading}}" bindtap="sendMessage" hover-class="is-pressed" aria-label="发送研究问题">{{isLoading ? '思考中' : '发送'}}</button></view>
</view>
