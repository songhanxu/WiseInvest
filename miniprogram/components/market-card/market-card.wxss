:host { display: block; height: 100%; }
.market-card { position: relative; width: 100%; height: 100%; min-height: 254rpx; margin: 0; padding: 26rpx; background: #fff; border: 1rpx solid #e5e9e0; border-radius: 20rpx; text-align: left; box-sizing: border-box; color: #232b24; line-height: 1.5; }
.market-card::after { border: 0; }
.market-symbol { width: 60rpx; height: 60rpx; border-radius: 12rpx; background: #edf2e8; color: #496443; display: flex; align-items: center; justify-content: center; font-size: 24rpx; font-weight: 550; margin-bottom: 24rpx; }
.market-name { font-size: 30rpx; font-weight: 550; }
.market-subtitle { font-size: 20rpx; color: #74806c; margin-top: 6rpx; }
.market-desc { font-size: 22rpx; color: #66765d; margin-top: 14rpx; }
.market-arrow { position: absolute; top: 24rpx; right: 24rpx; color: #8c9a82; font-size: 28rpx; }
.market-card-pressed { background: #f0f5e9; }
.market-card-wide { display: flex; align-items: center; min-height: 142rpx; gap: 24rpx; }
.market-card-wide .market-symbol { margin-bottom: 0; flex-shrink: 0; }
.market-card-wide .market-content { min-width: 0; padding-right: 28rpx; }
.market-card-wide .market-desc { margin-top: 8rpx; }
.market-card-wide .market-subtitle { display: none; }
@media (max-width: 340px) { .market-card { padding: 22rpx; }.market-name { font-size: 29rpx; } }
