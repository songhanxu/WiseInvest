:host { display: block; }
.row { width: 100%; min-height: 126rpx; padding: 22rpx 20rpx; margin: 0; border: 0; border-radius: 12rpx; background: #fff; color: #232b24; text-align: left; display: flex; align-items: center; gap: 20rpx; box-sizing: border-box; }
.row::after { border: 0; }.row-pressed { background: #f2f6ed; }
.icon-box { width: 62rpx; height: 62rpx; flex-shrink: 0; border-radius: 12rpx; background: #f1f4ed; color: #58704c; display: flex; align-items: center; justify-content: center; font-size: 23rpx; font-weight: 500; }
.meta { flex: 1; min-width: 0; }
.title { color: #2c3728; font-size: 27rpx; font-weight: 500; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.description { margin-top: 8rpx; color: #7b8772; font-size: 21rpx; }
.meta-dot { padding: 0 10rpx; color: #a0aa98; }
.arrow { color: #9aa68e; font-size: 34rpx; padding-left: 8rpx; }
