:host { display: block; }
.bubble-row { display: flex; width: 100%; margin-bottom: 30rpx; }
.row-user { justify-content: flex-end; }.row-assistant { justify-content: flex-start; }
.bubble-wrap { min-width: 0; max-width: 100%; }
.bubble { padding: 24rpx; border-radius: 18rpx; word-break: break-word; overflow-wrap: anywhere; }
.row-user .bubble-wrap { max-width: 92%; }
.bubble-user { background: var(--ui-fill); color: var(--ui-text); border-bottom-right-radius: 6rpx; }
.bubble-assistant { background: var(--ui-panel); color: var(--ui-text); border-bottom-left-radius: 6rpx; }
.thinking-box { background: var(--ui-bg); border-radius: 10rpx; padding: 16rpx; margin-bottom: 18rpx; }
.thinking-line { color: var(--ui-muted); font-size: 23rpx; line-height: 1.7; }
.content { display: block; white-space: normal; line-height: 1.85; font-size: 28rpx; }
.streaming { display: flex; gap: 8rpx; margin-top: 12rpx; color: var(--ui-muted); font-size: 16rpx; }
.meta { margin-top: 8rpx; display: flex; align-items: center; gap: 14rpx; color: var(--ui-muted); }
.meta-user { justify-content: flex-end; }.meta-assistant { justify-content: flex-start; }
.time { font-size: 20rpx; }
.actions { display: flex; gap: 6rpx; }
.action { min-height: 44px; min-width: 44px; padding: 20rpx 12rpx; color: var(--ui-muted); font-size: 22rpx; }

.bubble-assistant { padding-left: 0; padding-right: 0; background: transparent; border-radius: 0; color: var(--ui-text); }.bubble-user { background: var(--ui-bg); color: var(--ui-text); border-radius: 24rpx; }.bubble { line-height: 1.75; }.meta { color: var(--ui-faint); }
